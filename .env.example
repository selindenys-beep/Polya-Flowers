# ─────────────────────────────────────────────────────────────
# Приклад конфігурації. Скопіюй у файл .env та заповни значення.
# .env НІКОЛИ не потрапляє в git (див. .gitignore).
# На Render ці ж змінні задаються в розділі Environment.
# ─────────────────────────────────────────────────────────────

# --- Anthropic (Claude) ---
# Haiku — для спілкування в боті; Sonnet — для генерації тексту/описів.
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001
CLAUDE_TEXT_MODEL=claude-sonnet-5

# --- OpenAI (обробка зображень: фон/композиція) ---
OPENAI_API_KEY=

# --- Telegram ---
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# ID групи-каналу, куди публікуються товари (напр. -1001234567890)
TELEGRAM_GROUP_CHAT_ID=

# --- Google Sheets ---
# ID таблиці (з URL між /d/ та /edit)
GOOGLE_SHEET_ID=1Kk2nMo8f9Zoq8o9KTw9UAX0FYziwPx4_uRifPW2_uXY
# Шлях до JSON сервіс-акаунта АБО вміст JSON у GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Оплата (monobank «Банка») ---
# Посилання на банку/оплату, яке відкривається по кнопці «Оплатити»
MONOBANK_JAR_URL=

# --- Захист дашборда ---
# Простий пароль для входу в дашборд (щоб публікувала лише донька)
DASHBOARD_PASSWORD=

# --- Загальне ---
PUBLIC_BASE_URL=http://localhost:8000
